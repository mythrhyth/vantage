# PostgreSQL Database Connection URL (Neon Cloud or Local)
DATABASE_URL="postgresql://user:password@ep-sample-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=3000

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"

# NLP Provider Mode ('gemini' or 'development')
NLP_PROVIDER=development
